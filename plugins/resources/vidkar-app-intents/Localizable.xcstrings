{
  "sourceLanguage": "en",
  "strings": {
    "Consulta el catálogo": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Consulta el catálogo" } } } },
    "Consulta el catálogo: ${query}": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Consulta el catálogo: ${query}" } } } },
    "Consulta información de películas, series, cursos y productos autorizados sin abrir VIDKAR ni reproducir contenido.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Consulta información de películas, series, cursos y productos autorizados sin abrir VIDKAR ni reproducir contenido." } } } },
    "Qué quieres consultar": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Qué quieres consultar" } } } },
    "Coincidencia del catálogo": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Coincidencia del catálogo" } } } },
    "Tipo": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Tipo" } } } },
    "Identificador de origen": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Identificador de origen" } } } },
    "Indica qué quieres consultar: de 1 a 120 caracteres, sin caracteres de control.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Indica qué quieres consultar: de 1 a 120 caracteres, sin caracteres de control." } } } },
    "Configura primero MCP en VIDKAR para consultar el catálogo con Siri.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Configura primero MCP en VIDKAR para consultar el catálogo con Siri." } } } },
    "La sesión MCP no es válida. Revisa tu sesión y token en VIDKAR.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "La sesión MCP no es válida. Revisa tu sesión y token en VIDKAR." } } } },
    "No tienes permiso para consultar este catálogo en VIDKAR.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "No tienes permiso para consultar este catálogo en VIDKAR." } } } },
    "No se pudo conectar con VIDKAR. Comprueba la conexión e inténtalo de nuevo.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "No se pudo conectar con VIDKAR. Comprueba la conexión e inténtalo de nuevo." } } } },
    "La sesión de VIDKAR cambió durante la consulta. Vuelve a intentarlo.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "La sesión de VIDKAR cambió durante la consulta. Vuelve a intentarlo." } } } },
    "VIDKAR devolvió una respuesta de catálogo no válida. Inténtalo de nuevo.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "VIDKAR devolvió una respuesta de catálogo no válida. Inténtalo de nuevo." } } } },
    "No se pudo consultar el catálogo de VIDKAR. Inténtalo de nuevo más tarde.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "No se pudo consultar el catálogo de VIDKAR. Inténtalo de nuevo más tarde." } } } },
    "No encontré coincidencias en el catálogo autorizado de VIDKAR.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "No encontré coincidencias en el catálogo autorizado de VIDKAR." } } } },
    "Encontré una coincidencia en VIDKAR. %@": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Encontré una coincidencia en VIDKAR. %@" } } } },
