    "Más datos de este usuario": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Más datos de este usuario" } } } },
    "Actualiza la ficha del usuario recibido: identidad, rol, alta, estado, consumo, límites y vencimientos de Proxy y VPN. Revalida el acceso; no abre VIDKAR ni cambia datos.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Actualiza la ficha del usuario recibido: identidad, rol, alta, estado, consumo, límites y vencimientos de Proxy y VPN. Revalida el acceso; no abre VIDKAR ni cambia datos." } } } },
    "Consulta la ficha completa de ${user}": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Consulta la ficha completa de ${user}" } } } },
    "Consulta la ficha completa de %@": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Consulta la ficha completa de %@" } } } },
    "La ficha actualizada está disponible en la tarjeta.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "La ficha actualizada está disponible en la tarjeta." } } } },
    "Qué puedo consultar en VIDKAR": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Qué puedo consultar en VIDKAR" } } } },
    "Describe las consultas de solo lectura disponibles dentro de Siri y sus límites. No abre VIDKAR ni obtiene datos privados.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Describe las consultas de solo lectura disponibles dentro de Siri y sus límites. No abre VIDKAR ni obtiene datos privados." } } } },
    "Puedes consultar usuarios, consumo, ventas y catálogos. Los detalles y límites están en la tarjeta.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Puedes consultar usuarios, consumo, ventas y catálogos. Los detalles y límites están en la tarjeta." } } } },
    "Busca un username exacto dentro del alcance autorizado. Devuelve foto, nombre, rol, alta, estado y consumo de Proxy y VPN en una ficha resoluble sin abrir VIDKAR ni verbalizar datos privados.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Busca un username exacto dentro del alcance autorizado. Devuelve foto, nombre, rol, alta, estado y consumo de Proxy y VPN en una ficha resoluble sin abrir VIDKAR ni verbalizar datos privados." } } } },
    "El usuario ya no está disponible dentro de tu alcance autorizado de VIDKAR.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "El usuario ya no está disponible dentro de tu alcance autorizado de VIDKAR." } } } },
    "¿Qué película quieres buscar?": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "¿Qué película quieres buscar?" } } } },
    "¿Qué serie quieres buscar?": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "¿Qué serie quieres buscar?" } } } },
    "¿Qué producto quieres buscar?": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "¿Qué producto quieres buscar?" } } } },
