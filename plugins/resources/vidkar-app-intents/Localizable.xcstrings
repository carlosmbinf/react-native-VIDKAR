    "Consulta Proxy o VPN de la cuenta indicada por username o por una entidad de usuario devuelta antes. Si omites usuario, consulta tu cuenta. Solo lectura autorizada; no muestra contraseñas ni servidores.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Consulta Proxy o VPN de la cuenta indicada por username o por una entidad de usuario devuelta antes. Si omites usuario, consulta tu cuenta. Solo lectura autorizada; no muestra contraseñas ni servidores." } } } },
    "Consulta consumo de ${service} de ${user}": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Consulta consumo de ${service} de ${user}" } } } },
