    "Ejecuta una herramienta MCP de solo lectura con los parámetros JSON indicados y devuelve el resultado estructurado en JSON.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Ejecuta una herramienta MCP de solo lectura con los parámetros JSON indicados y devuelve el resultado estructurado en JSON." } } } },
    "Consulta el uso del servicio seleccionado. Requiere confirmación y solo devuelve estado y consumo, nunca credenciales ni servidores.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Consulta el uso del servicio seleccionado. Requiere confirmación y solo devuelve estado y consumo, nunca credenciales ni servidores." } } } },
    "Descubre las herramientas MCP disponibles de VIDKAR y devuelve su nombre, descripción, datos de entrada y permisos en JSON.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Descubre las herramientas MCP disponibles de VIDKAR y devuelve su nombre, descripción, datos de entrada y permisos en JSON." } } } },
    "Busca productos únicamente en el catálogo COMERCIO de VIDKAR.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Busca productos únicamente en el catálogo COMERCIO de VIDKAR." } } } },
    "Busca cursos publicados y autorizados para el usuario en VIDKAR.": { "localizations": { "es": { "stringUnit": { "state": "translated", "value": "Busca cursos publicados y autorizados para el usuario en VIDKAR." } } } },
