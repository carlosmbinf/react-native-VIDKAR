      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-vlc-media-player",
          "react-native-vector-icons",
          "cadete-background-tracking",
          "vidkar-pip",
          "vidkar-spotlight",
          "vidkar-watch-bridge"
