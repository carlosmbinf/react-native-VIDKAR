{
  "name": "Vidkar",
  "main": "./index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "postinstall": "node ./scripts/patch-apple-targets-watch-prebuild.js && node ./scripts/patch-vlc-media-player.js && node ./scripts/patch-react-native-paper-portals.js && node ./scripts/patch-meteorrn-scheduler.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:mcp": "node --experimental-default-type=module --test tests/mcpAccess.test.js tests/homeServices.test.js tests/commerceHomeSection.test.js tests/publicUrls.test.js tests/mcpProtocol.test.js tests/universalLinks.test.js",
    "test:mcp:ios": "node --test tests/mcpAppIntentsCompile.test.cjs tests/mcpAppIntentsMetadata.test.cjs tests/appIntentsArtifact.test.cjs tests/mcpQueryPolicy.test.cjs tests/iosSceneLifecycle.test.cjs tests/siriSearchNavigation.test.cjs",
    "test:widget-refresh": "node --test tests/widgetMcpRefresh.test.cjs",
    "test:settlement": "node --experimental-default-type=module --test tests/settlementAdmin.test.js",
    "test:ios-scene": "node --test tests/iosSceneLifecycle.test.cjs",
    "eval:mcp:ai": "node tests/mcpNaturalLanguage.eval.cjs",
    "build": "node ./scripts/patch-apple-targets-watch-prebuild.js && node ./scripts/patch-vlc-media-player.js && node ./scripts/patch-react-native-paper-portals.js && node ./scripts/patch-meteorrn-scheduler.js && expo prebuild"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.6",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "^15.0.3",
    "@meteorrn/core": "^2.9.1",
    "@pksung1/expo-store-signing": "^1.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "date-fns": "^4.1.0",
    "expo": "^58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.27",
    "moment": "^2.30.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-calendar-picker": "^8.0.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-vlc-media-player": "^1.0.98",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "vidkar-mcp": "file:modules/vidkar-mcp",
    "vidkar-spotlight": "file:modules/vidkar-spotlight"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-vlc-media-player",
          "react-native-vector-icons",
          "cadete-background-tracking",
          "vidkar-pip",
          "vidkar-spotlight",
          "vidkar-watch-bridge"
        ]
      }
    }
  }
}
