# Endpoints públicos de la app VIDKAR. No colocar aquí secretos.
# Un solo origen base genera DDP (ws/wss), MCP y las rutas HTTP del sitio.
EXPO_PUBLIC_VIDKAR_BASE_URL=https://www.vidkar.com

# HLS es un servicio separado. Cambiarlo solo si se mueve ese servicio.
EXPO_PUBLIC_HLS_SERVER_URL=https://hls.vidkar.com

# Overrides opcionales para instalaciones con rutas/hosts no convencionales.
# EXPO_PUBLIC_METEOR_URL=wss://www.vidkar.com/websocket
# EXPO_PUBLIC_MCP_URL=https://www.vidkar.com/mcp
