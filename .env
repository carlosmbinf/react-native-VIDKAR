# Variables opcionales para firmar builds locales.
# Codemagic las proporciona mediante el grupo de variables de firma.
# CM_KEYSTORE_PASSWORD=
# CM_KEY_ALIAS=
# CM_KEY_PASSWORD=

# Endpoints públicos de la app VIDKAR. No colocar aquí secretos.
# Cambiar esta URL base cambia por defecto el login/DDP y el endpoint MCP.
EXPO_PUBLIC_VIDKAR_BASE_URL=https://www.vidkar.com

# HLS es un servicio separado y por eso conserva su propio endpoint.
EXPO_PUBLIC_HLS_SERVER_URL=https://hls.vidkar.com

# Overrides opcionales; normalmente se derivan de VIDKAR_BASE_URL.
# El login/DDP usa la URL derivada del túnel configurado arriba.
# MCP es otro servicio; conservar producción al desarrollar contra el túnel Meteor.
EXPO_PUBLIC_MCP_URL=https://www.vidkar.com/mcp
